{
  "name": "basic-pdf",
  "productName": "Basic PDF",
  "version": "3.1.0",
  "description": "Desktop PDF editor (Tauri)",
  "author": "barrven",
  "license": "MIT",
  "scripts": {
    "start": "tauri dev",
    "dev": "tauri dev",
